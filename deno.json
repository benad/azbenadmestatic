{
  "imports": {
    "@11ty/eleventy": "npm:@11ty/eleventy",
    "@11ty/eleventy-plugin-rss": "npm:@11ty/eleventy-plugin-rss",
    "luxon": "npm:luxon",
    "adm-zip": "npm:adm-zip",
    "@xmldom/xmldom": "npm:@xmldom/xmldom",
    "@tradik/xslt-processor": "npm:@tradik/xslt-processor",
    "@iarna/toml": "npm:@iarna/toml"
  },

  "nodeModulesDir": "none",

  "compilerOptions": {
    "strict": false,
    "checkJs": true
  },

  "permissions": {
    "default": {
      "read": ["./", "./src", "./public"],
      "write": ["./_site"],
      "env": true,
      "sys": true,
      "net": ["localhost:8080", "0.0.0.0:8080", "[::]:8080"]
    }
  },

  "tasks": {
    "build": "deno run -P npm:@11ty/eleventy",
    "start": "DENO_DIR=./.deno deno run -P npm:@11ty/eleventy --serve --quiet --port=8080",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check eleventy.config.mjs",
    "ci": "deno task lint && deno task check && deno task build"
  },

  "exclude": ["_site", "node_modules", "src"]
}